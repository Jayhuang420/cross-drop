# ===== TURN relay (needed for devices on DIFFERENT networks: 4G vs Wi-Fi, CGNAT…) =====
# Providers are tried in this order; each is verified with a real TURN Allocate
# before use, so a dead / over-quota provider is skipped automatically.
# Check health after changing anything:  GET /api/turn-status
# Override the order with e.g. TURN_PROVIDERS=cloudflare,static,metered

# 1) Cloudflare Realtime TURN (1 TB/month free) — dash.cloudflare.com → Realtime → TURN → create key
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# 2) Any static TURN (self-hosted coturn, ExpressTURN, …): comma-separated urls + long-term creds
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# 3) metered.ca (free plan is now only 500 MB/month; credentials get disabled when exceeded)
METERED_TURN_API_KEY=
# METERED_TURN_API_URL=https://oldjailab.metered.live/api/v1/turn/credentials

# TURN_PROBE=off   # skip the allocate probe (not recommended)
